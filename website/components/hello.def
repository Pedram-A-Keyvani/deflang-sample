use language/html
use language/javascript
use language/css

argument is A
comment is //

// Asks for a name and shows def-lang's greeting.
// Example: serve site page at "/"
//          → GET /hello answers a page containing <h1>Say hello</h1>
html hello view
    <view path="/hello" title="Say hello">
        <style def="hello style"></style>
        <h1>Say hello</h1>
        <form api="/api/hello">
            <input name="name" placeholder="Your name" autocomplete="given-name" maxlength="20">
            <button>Greet me</button>
        </form>
        <p class="hint">20 characters left</p>
        <p class="result" hidden>{greeting}</p>
        <script def="count the characters left"></script>
    </view>

// While the visitor types, says how many characters the name may still have. It happens in the browser on each key: def-lang on the server only hears about the name when the form is sent.
// Example: serve site page at "/"
//          → GET /hello answers a page containing input.maxLength - input.value.length
javascript count the characters left
    // the limit is the input's maxlength; the browser keeps to it
    const input = view.querySelector('input[name="name"]');
    const hint = view.querySelector('.hint');
    input.addEventListener('input', () => {
        const left = input.maxLength - input.value.length;
        hint.textContent = left + (left === 1 ? ' character' : ' characters') + ' left';
    });

// How the hello view looks: the hint under the name is small and gray, and the greeting is larger. It only styles this view.
// Example: serve site page at "/"
//          → GET /hello answers a page containing .hint { color: var(--muted)
css hello style
    .hint {
        color: var(--muted);
        font-size: .9rem;
        margin-top: .3rem;
    }

    .result {
        font-size: 1.2rem;
    }

// ---- its data: what def/routes.def sends

// Hello, and the name in `?name=`, or stranger.
// Example: greeting, for GET /api/hello?name=Sam
//          → "Hello, Sam!"
def greeting
    name is query "name"
    is name empty?
        name is "stranger"
    "Hello, " name "!"

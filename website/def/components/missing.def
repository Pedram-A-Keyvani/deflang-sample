use language/html
use language/css

argument is A
comment is //

// Shown for an address the app doesn't know (path="*" means any other address).
// Example: serve site page at "/"
//          → GET /nowhere answers a page containing <h1>You are lost</h1>
html missing view
    <view path="*" title="Not found">
        <style def="missing style"></style>
        <h1>You are lost</h1>
        <p>Do you need help? <a href="/">Yes, navigate me home</a>.</p>
    </view>

// How the missing view looks: centred, with a big heading. It only styles this view.
// Example: serve site page at "/"
//          → GET /nowhere answers a page containing h1 { font-size: 3rem; }
css missing style
    & {
        text-align: center;
    }

    h1 {
        font-size: 3rem;
    }

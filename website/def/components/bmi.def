use language/html
use language/css

argument is A
comment is //

// The BMI calculator: def-lang works it out, from a height in m or cm.
// Example: serve site page at "/"
//          → GET /bmi answers a page containing <h1>BMI calculator</h1>
html bmi view
    <view path="/bmi" title="BMI calculator">
        <style def="bmi style"></style>
        <h1>BMI calculator</h1>
        <form api="/api/bmi">
            <input name="weight" placeholder="Weight (kg)" inputmode="decimal" required>
            <input name="height" placeholder="Height (m or cm)" inputmode="decimal" required>
            <button>Calculate</button>
        </form>
        <p class="result" hidden>Your BMI is <strong>{bmi}</strong>. That is <strong>{verdict}</strong>.</p>
    </view>

// How the BMI view looks: the result is larger, and the BMI and verdict stand out. It only styles this view.
// Example: serve site page at "/"
//          → GET /bmi answers a page containing .result strong { color: var(--accent); }
css bmi style
    .result {
        font-size: 1.2rem;
    }

    .result strong {
        color: var(--accent);
    }

// ---- its data: what def/routes.def sends

// The BMI from `?weight=` (kg) and `?height=` (m or cm).
// Example: bmi, for GET /api/bmi?weight=70&height=175
//          → 22.9
def bmi
    weight is query "weight"
    height is query "height"
    // a height over 3 can only be centimeters
    height is height / 100 if height > 3 otherwise height
    weight / height squared rounded to 1 place

// What the BMI means: underweight, healthy or overweight.
// Example: verdict, for GET /api/bmi?weight=70&height=1.75
//          → "healthy"
def verdict
    is bmi < 18.5?
        "underweight"
    is bmi between 18.5 and 25?
        "healthy"
    is bmi >= 25?
        "overweight"

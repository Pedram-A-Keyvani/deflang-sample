use html
use css

argument is A
comment is //

// The front page: counts the visit and shows the time.
// Example: serve site page at "/"
//          → GET / answers a page containing <h1>Served by def-lang</h1>
def html home view
    <view path="/" title="Served by def-lang" loads="/api/visit">
        <style def="home style"></style>
        <h1>Served by def-lang</h1>
        <p hidden>This site has been visited <strong>{visits}</strong> times.
            It is {time} on {today}.</p>
        <p>Every view is part of one page: switching between them doesn't reload it.</p>
    </view>

// How the home view looks: the visit count stands out. It only styles this view.
// Example: serve site page at "/"
//          → GET / answers a page containing strong { color: var(--accent); }
def css home style
    strong {
        color: var(--accent);
    }

// ---- its data: what def/routes.def sends

shared visits is 0

// Counts a visit to the home view.
// Example: count the visit
//          → visits is 3, when visits was 2
def count the visit
    visits is visits + 1

argument is A
comment is //

// What the single page application asks the server for. main.def's api lines send
// these values as JSON. Each def works out its value for the request it answers:
// its variables are its own, so nothing reaches another view or visitor. Only
// visits is shared, on purpose: every visitor counts on it.

shared visits is 0

// Counts a visit to the home view.
// Example: count the visit
//          → visits is 3, when visits was 2
def count the visit
    visits is visits + 1

// Hello, and the name in `?name=`, or stranger.
// Example: greeting, for GET /api/hello?name=Sam
//          → "Hello, Sam!"
def greeting
    name is query "name"
    is name empty?
        name is "stranger"
    "Hello, " name "!"

// The BMI from `?weight=` (kg) and `?height=` (m or cm).
// Example: bmi, for GET /api/bmi?weight=70&height=175
//          → 22.9
def bmi
    weight is query "weight"
    height is query "height"
    // a height over 3 can only be centimetres
    height is height / 100 if height > 3 otherwise height
    weight / height squared rounded to 1 places

// What the BMI means: underweight, healthy or overweight.
// Example: verdict, for GET /api/bmi?weight=70&height=1.75
//          → "healthy"
def verdict
    is bmi < 18.5?
        "underweight"
    is bmi between 18.5 and 25?
        "healthy"
    is bmi >= 25?
        "overweight"
